  <data name="SettingsWindow.LanguageTitle.Text" xml:space="preserve"><value>表示言語</value></data>
  <data name="SettingsWindow.LanguageDesc.Text" xml:space="preserve"><value>アプリで使用する言語を選択します。未対応の文言は英語で表示されます。</value></data>
