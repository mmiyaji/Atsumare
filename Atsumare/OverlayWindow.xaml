<Window
    x:Class="Atsumare.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#99000000">
        <Border
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            CornerRadius="16"
            Background="#CC202020"
            Padding="16"
            Width="720"
            MaxHeight="700">

            <StackPanel Spacing="12">
                <TextBlock x:Name="TitleText" Text="Atsumare" FontSize="20"/>

                <ScrollViewer MaxHeight="620">
                    <GridView x:Name="AppsGrid"
                              IsItemClickEnabled="True"
                              ItemClick="AppsGrid_ItemClick"
                              SelectionMode="None">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="local:AppItemVm"
                                          xmlns:local="using:Atsumare">
                                <StackPanel Width="120" Spacing="6">
                                    <Grid Width="84" Height="84">
                                        <Border CornerRadius="16" Background="#2AFFFFFF"/>
                                        <Image Source="{x:Bind Icon}" Stretch="Uniform" Margin="12"/>
                                        <Border Background="#CC000000"
                                                CornerRadius="10"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,6,6"
                                                Padding="6,2">
                                            <TextBlock Text="{x:Bind Count}" FontSize="12"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" MaxLines="2"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </ScrollViewer>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button Content="更新" Click="Refresh_Click"/>
                    <Button Content="閉じる" Click="Close_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
