<Window
    x:Class="Atsumare.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Atsumare"
    Title="Atsumare">

    <Border CornerRadius="20"
            Padding="16,16,16,0"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

        <Grid RowDefinitions="Auto,Auto,*,Auto"
              Padding="16,24,16,0"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

            <Grid Grid.Row="0"
                  Margin="0,4,0,0">
                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="0,-22,0,0"
                        Padding="8,2"
                        CornerRadius="8"
                        Background="#33222222"
                        Opacity="0.78"
                        IsHitTestVisible="False">
                    <TextBlock x:Name="AppVersionBadge"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Text="Atsumare"/>
                </Border>

                <TextBox x:Name="FilterBox"
                         x:Uid="MainWindow.SearchBox"
                         AutomationProperties.AutomationId="FilterBox"
                         PlaceholderText="Search apps..."
                         FontSize="15"
                         Height="40"
                         CornerRadius="12"
                         VerticalContentAlignment="Center"
                         Padding="42,6,12,4"
                         TextChanged="FilterBox_TextChanged"/>

                <Button Width="40"
                        Height="32"
                        Margin="6,0,6,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        IsTabStop="False"
                        Click="SearchIcon_Click">
                    <FontIcon Glyph="&#xE721;"
                              FontFamily="Segoe MDL2 Assets"
                              FontSize="16"
                              Opacity="0.75"/>
                </Button>
            </Grid>

            <Border x:Name="DebugBanner"
                    Grid.Row="1"
                    Margin="0,10,0,4"
                    Padding="10,6"
                    CornerRadius="10"
                    Background="#3322AA66"
                    BorderBrush="#66AAFFCC"
                    BorderThickness="1"
                    Visibility="Collapsed">
                <TextBlock Text="DEBUG BUILD: tile text must show icon source and PID"
                           FontSize="12"
                           FontWeight="SemiBold"/>
            </Border>

            <GridView x:Name="AppsGrid"
                      AutomationProperties.AutomationId="AppsGrid"
                      Grid.Row="2"
                      Opacity="0"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      SizeChanged="AppsGrid_SizeChanged"
                      ItemsSource="{x:Bind FilteredItems}"
                      IsItemClickEnabled="True"
                      ItemClick="GridView_ItemClick"
                      SelectionMode="None"
                      IsTabStop="False">

                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid x:Name="WrapPanel"
                                       Orientation="Horizontal"
                                       ItemHeight="154"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>

                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Height" Value="144"/>
                        <Setter Property="Margin" Value="4,7"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="CornerRadius" Value="14"/>
                        <Setter Property="UseSystemFocusVisuals" Value="False"/>
                    </Style>
                </GridView.ItemContainerStyle>

                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="local:AppGroupItem">
                        <Border CornerRadius="14"
                                AutomationProperties.Name="{x:Bind AppName}"
                                Padding="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <Border.Shadow>
                                <ThemeShadow/>
                            </Border.Shadow>

                            <Grid RowDefinitions="*,Auto,Auto" RowSpacing="4">
                                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Image Width="50"
                                           Height="50"
                                           Stretch="Uniform"
                                           Source="{x:Bind Icon, Mode=OneWay}" />
                                </Grid>

                                <TextBlock Grid.Row="1"
                                           Text="{x:Bind AppName, Mode=OneWay}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="3"/>
                                <TextBlock Grid.Row="2"
                                           Text="{x:Bind Description, Mode=OneWay}"
                                           FontSize="10"
                                           Opacity="0.9"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxLines="2"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <Grid x:Name="StartupSplash"
                  AutomationProperties.AutomationId="StartupSplash"
                  Grid.RowSpan="4"
                  Background="#AA151515"
                  Visibility="Visible"
                  IsHitTestVisible="False">
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="28,22"
                        CornerRadius="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="10">
                        <Button AutomationProperties.AutomationId="StartupSplashAnchor"
                                Width="1"
                                Height="1"
                                Opacity="0.001"
                                IsTabStop="False"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Padding="0"
                                BorderThickness="0"
                                Background="Transparent"/>
                        <TextBlock Text="Atsumare"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <ProgressRing x:Name="StartupSplashRing"
                                      AutomationProperties.AutomationId="StartupSplashRing"
                                      Width="28"
                                      Height="28"
                                      IsActive="True"
                                      HorizontalAlignment="Center"/>
                        <TextBlock x:Name="StartupSplashText"
                                   AutomationProperties.AutomationId="StartupSplashText"
                                   Text="Loading apps..."
                                   FontSize="13"
                                   Opacity="0.82"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3"
                    Height="40"
                    CornerRadius="10"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    Padding="10,0"
                    Margin="0">

                <Button x:Name="SettingsButton"
                        AutomationProperties.AutomationId="SettingsButton"
                        Click="SettingsButton_Click"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6,0"
                        MinHeight="28">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Opacity="0.85"/>
                        <TextBlock x:Name="SettingsButtonText" x:Uid="MainWindow.SettingsText" Text="Settings" FontSize="12" Opacity="0.9" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Border>

            <Grid x:Name="MoveOverlay"
                  AutomationProperties.AutomationId="MoveOverlay"
                  Grid.RowSpan="4"
                  Background="#88000000"
                  Visibility="Collapsed"
                  IsHitTestVisible="False">
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="24,18"
                        CornerRadius="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="8">
                        <ProgressRing x:Name="MoveOverlayRing"
                                      Width="28"
                                      Height="28"
                                      IsActive="False"
                                      HorizontalAlignment="Center"/>
                        <TextBlock x:Name="MoveOverlayText"
                                   x:Uid="MainWindow.MoveOverlayText"
                                   Text="Moving..."
                                   FontSize="16"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="DebugRibbon"
                    Grid.RowSpan="4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,12,12"
                    Padding="10,6"
                    CornerRadius="10"
                    Background="#CC8B0000"
                    BorderBrush="#FFFFC857"
                    BorderThickness="1"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <TextBlock x:Name="DebugRibbonTextBlock"
                           Text=""
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="White"
                           TextAlignment="Right"
                           TextWrapping="Wrap"
                           MaxLines="4"/>
            </Border>
        </Grid>
    </Border>
</Window>
