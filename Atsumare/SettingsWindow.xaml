<Window
    x:Class="Atsumare.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="設定">

    <Grid>
        <NavigationView
            x:Name="Nav"
            AutomationProperties.AutomationId="Nav"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            KeyDown="HotkeyCaptureScope_KeyDown"
            PaneDisplayMode="Left"
            SelectionChanged="Nav_SelectionChanged"
            CompactModeThresholdWidth="760"
            ExpandedModeThresholdWidth="980"
            Opacity="0">

        <!-- WinUI 3: Resources はここに置く -->
        <NavigationView.Resources>
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14"/>
                <Setter Property="Margin" Value="0"/>
            </Style>

            <Style x:Key="CardTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="CardDescStyle" TargetType="TextBlock">
                <Setter Property="Opacity" Value="0.75"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="SectionSubTitleStyle" TargetType="TextBlock">
                <Setter Property="Opacity" Value="0.7"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </NavigationView.Resources>

        <NavigationView.MenuItems>
            <NavigationViewItem Content="全般" Tag="general" AutomationProperties.AutomationId="NavGeneral">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="移動" Tag="move" AutomationProperties.AutomationId="NavMove">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Forward"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="アプリ一覧" Tag="applist" AutomationProperties.AutomationId="NavAppList">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="AllApps"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="ログ" Tag="log" AutomationProperties.AutomationId="NavLog">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Library"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="拡張機能" Tag="ext" AutomationProperties.AutomationId="NavExt">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Admin"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="情報" Tag="about" AutomationProperties.AutomationId="NavAbout">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Help"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem Content="ライセンス" Tag="licenses" AutomationProperties.AutomationId="NavLicenses">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Document"/>
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.Content>
            <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RootPanel" Spacing="12">

                    <!-- Header -->
                    <Grid Margin="0,0,0,10">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="PageTitle" Text="全般" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock x:Name="PageSubtitle" Text="基本動作を設定します" Style="{StaticResource SectionSubTitleStyle}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="PanelGeneral" Spacing="12" Visibility="Visible">
                        <Border Style="{StaticResource CardBorderStyle}" Tag="起動 トレイ 最小化 startup tray minimize">
                            <StackPanel Spacing="6">
                                <TextBlock Text="起動時にトレイへ最小化" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock Text="起動時にメインウィンドウを表示せず、トレイ常駐で開始します。" Style="{StaticResource CardDescStyle}"/>
                                <ToggleSwitch x:Name="SwStartMinToTray" AutomationProperties.AutomationId="SwStartMinToTray" Toggled="AnySetting_Toggled"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Tag="閉じる × トレイ 最小化 close tray minimize">
                            <StackPanel Spacing="6">
                                <TextBlock Text="×ボタンで終了せずトレイへ最小化" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock Text="ウィンドウを閉じる操作を、終了ではなくトレイ最小化として扱います。" Style="{StaticResource CardDescStyle}"/>
                                <ToggleSwitch x:Name="SwCloseMinToTray" AutomationProperties.AutomationId="SwCloseMinToTray" Toggled="AnySetting_Toggled"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Tag="startup launch windows run">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Windows 起動時に自動起動" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock Text="ユーザーのサインイン時に Atsumare を自動起動します。" Style="{StaticResource CardDescStyle}"/>
                                <ToggleSwitch x:Name="SwLaunchAtStartup" AutomationProperties.AutomationId="SwLaunchAtStartup" Toggled="AnySetting_Toggled"/>
                                <TextBlock x:Name="TbStartupStatus" AutomationProperties.AutomationId="TbStartupStatus" Style="{StaticResource CardDescStyle}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Tag="ホットキー hotkey shortcut">
                            <StackPanel Spacing="6">
                                <TextBlock Text="ホットキー" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock Text="ピッカー表示/非表示のショートカットを設定します。" Style="{StaticResource CardDescStyle}"/>

                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <CheckBox x:Name="CbModCtrl" AutomationProperties.AutomationId="CbModCtrl" Content="Ctrl" Checked="Hotkey_Changed" Unchecked="Hotkey_Changed"/>
                                    <CheckBox x:Name="CbModAlt"  AutomationProperties.AutomationId="CbModAlt" Content="Alt"  Checked="Hotkey_Changed" Unchecked="Hotkey_Changed"/>
                                    <CheckBox x:Name="CbModShift" AutomationProperties.AutomationId="CbModShift" Content="Shift" Checked="Hotkey_Changed" Unchecked="Hotkey_Changed"/>
                                    <!--<CheckBox x:Name="CbModWin"  Content="Win"  Checked="Hotkey_Changed" Unchecked="Hotkey_Changed"/> -->
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <TextBlock Text="キー" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CbHotkeyKey" AutomationProperties.AutomationId="CbHotkeyKey" Width="220" SelectionChanged="Hotkey_Changed"/>
                                    <Button x:Name="BtnCaptureHotkey"
                                            AutomationProperties.AutomationId="BtnCaptureHotkey"
                                            Content="ショートカットを記録"
                                            Click="BtnCaptureHotkey_Click"/>
                                    <Button x:Name="BtnResetHotkey"
                                            AutomationProperties.AutomationId="BtnResetHotkey"
                                            Content="既定に戻す"
                                            Click="BtnResetHotkey_Click"/>
                                    <TextBlock x:Name="TbHotkeyPreview" AutomationProperties.AutomationId="TbHotkeyPreview" VerticalAlignment="Center" Opacity="0.8"/>
                                </StackPanel>
                                <TextBlock x:Name="TbHotkeyStatus"
                                           AutomationProperties.AutomationId="TbHotkeyStatus"
                                           Style="{StaticResource CardDescStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PanelMove" Spacing="12" Visibility="Collapsed">
                        <Border Style="{StaticResource CardBorderStyle}" Tag="移動 オーバーレイ overlay move">
                            <StackPanel Spacing="6">
                                <TextBlock Text="移動時オーバーレイを表示" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock Text="ウィンドウ移動中にオーバーレイを表示します。問題切り分け用にOFF推奨の場合があります。" Style="{StaticResource CardDescStyle}"/>
                                <ToggleSwitch x:Name="SwShowOverlay" AutomationProperties.AutomationId="SwShowOverlay" Toggled="AnySetting_Toggled"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PanelAppList" Spacing="12" Visibility="Collapsed">
                        <Border Style="{StaticResource CardBorderStyle}" Tag="除外 プロセス app list filter exclude process">
                            <StackPanel Spacing="6">
                                <TextBlock Text="除外プロセス名" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock Text="一覧に出したくないプロセス名をカンマ区切りで指定します。（例: explorer, obs64）" Style="{StaticResource CardDescStyle}"/>
                                <TextBox x:Name="TbExcludeCsv" AutomationProperties.AutomationId="TbExcludeCsv" TextChanged="AnySetting_TextChanged"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PanelLog" Spacing="12" Visibility="Collapsed">
                        <Border Style="{StaticResource CardBorderStyle}" Tag="ログ debug verbose">
                            <StackPanel Spacing="6">
                                <TextBlock Text="詳細ログを有効化" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock Text="診断用のログ出力を増やします。通常はOFFで問題ありません。" Style="{StaticResource CardDescStyle}"/>
                                <ToggleSwitch x:Name="SwVerboseLog" AutomationProperties.AutomationId="SwVerboseLog" Toggled="AnySetting_Toggled"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorderStyle}" Tag="ログ フォルダ log folder">
                            <StackPanel Spacing="6">
                                <TextBlock Text="ログフォルダを開く" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock Text="%LocalAppData%\Atsumare\logs にログファイルが保存されます。" Style="{StaticResource CardDescStyle}"/>
                                <Button Content="フォルダを開く" AutomationProperties.AutomationId="OpenLogFolderButton" Click="OpenLogFolder_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PanelExt" Spacing="12" Visibility="Collapsed">
                        <Border Style="{StaticResource CardBorderStyle}" Tag="拡張 機能 extension">
                            <StackPanel Spacing="6">
                                <TextBlock Text="拡張機能" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock Text="将来拡張（例：移動ルール、特定アプリ連携など）をここに追加します。" Style="{StaticResource CardDescStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PanelAbout" Spacing="12" Visibility="Collapsed">
                        <Border Style="{StaticResource CardBorderStyle}" Tag="情報 about version author support">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Atsumare" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock Text="ウィンドウをディスプレイへまとめて移動するツール" Style="{StaticResource CardDescStyle}"/>
                                <TextBlock x:Name="TbAboutAuthor" AutomationProperties.AutomationId="TbAboutAuthor"/>
                                <TextBlock x:Name="TbAboutCopyright" AutomationProperties.AutomationId="TbAboutCopyright"/>
                                <TextBlock x:Name="TbAboutVersion" AutomationProperties.AutomationId="TbAboutVersion"/>
                                <TextBlock x:Name="TbAboutBuildDate" AutomationProperties.AutomationId="TbAboutBuildDate"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Tag="support github page privacy terms repository">
                            <StackPanel Spacing="6">
                                <TextBlock Text="サポート" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock Text="サポートページ、利用規約、プライバシーポリシー、リポジトリを開けます。" Style="{StaticResource CardDescStyle}"/>
                                <Button x:Name="BtnSupportUrl" AutomationProperties.AutomationId="BtnSupportUrl" HorizontalAlignment="Left" Click="BtnSupportUrl_Click"/>
                                <Button x:Name="BtnTermsUrl" AutomationProperties.AutomationId="BtnTermsUrl" HorizontalAlignment="Left" Click="BtnTermsUrl_Click"/>
                                <Button x:Name="BtnPrivacyUrl" AutomationProperties.AutomationId="BtnPrivacyUrl" HorizontalAlignment="Left" Click="BtnPrivacyUrl_Click"/>
                                <Button x:Name="BtnRepositoryUrl" AutomationProperties.AutomationId="BtnRepositoryUrl" HorizontalAlignment="Left" Click="BtnRepositoryUrl_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Tag="利用規約 terms legal">
                            <StackPanel Spacing="6">
                                <TextBlock Text="利用規約" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock Text="Atsumare は、ユーザー自身のデバイス上で現在開いているアプリのウィンドウを列挙し、別モニターへ移動するためのデスクトップユーティリティです。" TextWrapping="Wrap"/>
                                <TextBlock Text="インストールまたは利用により、適用法令を遵守し、自己の管理下にある環境でのみ利用することに同意するものとします。" TextWrapping="Wrap"/>
                                <TextBlock Text="本アプリは現状有姿で提供され、機能や互換性は更新により変更される場合があります。完全な条文はサポートページ上の利用規約を参照してください。" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="PanelLicenses" Spacing="12" Visibility="Collapsed">
                        <Border Style="{StaticResource CardBorderStyle}" Tag="third party license windows app sdk">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Microsoft Windows App SDK / WinUI 3" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock Text="Copyright © Microsoft Corporation. All rights reserved." Style="{StaticResource CardDescStyle}"/>
                                <TextBlock Text="This app depends on Microsoft Windows App SDK runtime and WinUI components." TextWrapping="Wrap"/>
                                <TextBlock Text="License: Microsoft Software License Terms" TextWrapping="Wrap"/>
                                <Button x:Name="BtnWindowsAppSdkUrl" AutomationProperties.AutomationId="BtnWindowsAppSdkUrl" HorizontalAlignment="Left" Click="BtnWindowsAppSdkUrl_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Tag="third party license dotnet runtime">
                            <StackPanel Spacing="6">
                                <TextBlock Text=".NET Runtime" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock Text="Copyright © .NET Foundation and contributors." Style="{StaticResource CardDescStyle}"/>
                                <TextBlock Text="License: MIT License" TextWrapping="Wrap"/>
                                <Button x:Name="BtnDotNetLicenseUrl" AutomationProperties.AutomationId="BtnDotNetLicenseUrl" HorizontalAlignment="Left" Click="BtnDotNetLicenseUrl_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Tag="third party license webview2 microsoft edge">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Microsoft Edge WebView2 Runtime" Style="{StaticResource CardTitleStyle}"/>
                                <TextBlock Text="Bundled components may include Microsoft Edge WebView2 loader/runtime dependencies provided through Windows App SDK distribution." TextWrapping="Wrap"/>
                                <TextBlock Text="License: Microsoft Software License Terms" TextWrapping="Wrap"/>
                                <Button x:Name="BtnWebView2Url" AutomationProperties.AutomationId="BtnWebView2Url" HorizontalAlignment="Left" Click="BtnWebView2Url_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Height="10" Opacity="0"/>
                </StackPanel>
            </ScrollViewer>
        </NavigationView.Content>
        </NavigationView>

        <Border x:Name="PaneResizeHandle"
                AutomationProperties.AutomationId="PaneResizeHandle"
                Width="10"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Background="Transparent"
                PointerEntered="PaneResizeHandle_PointerEntered"
                PointerExited="PaneResizeHandle_PointerExited"
                PointerPressed="PaneResizeHandle_PointerPressed"
                PointerMoved="PaneResizeHandle_PointerMoved"
                PointerReleased="PaneResizeHandle_PointerReleased"
                PointerCanceled="PaneResizeHandle_PointerReleased"
                Visibility="Collapsed">
            <Grid>
                <Border x:Name="PaneResizeHover"
                        Width="10"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Center"
                        Background="#143A7AFE"
                        CornerRadius="5"
                        Opacity="0"/>
                <Border x:Name="PaneResizeGrip"
                        Width="2"
                        IsHitTestVisible="False"
                        HorizontalAlignment="Center"
                        Background="#66A8B3C4"
                        CornerRadius="1"/>
            </Grid>
        </Border>
    </Grid>
</Window>

